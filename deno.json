{
  "version": "1.0.0",
  "tasks": {
    "start": "deno run --allow-ffi --allow-read --allow-env --allow-sys src/main.ts",
    "compile": "deno compile --output hbr-combat-macros.exe --include src/assets --allow-ffi --allow-read --allow-env --allow-sys src/main.ts"
  },
  "imports": {
    "@cliffy/prompt": "jsr:@cliffy/prompt@^1.3.1",
    "@std/async": "jsr:@std/async@^1",
    "@std/csv": "jsr:@std/csv@^1",
    "@techstark/opencv-js": "npm:@techstark/opencv-js@5.0.0-release.1",
    "fast-png": "npm:fast-png@^8"
  },
  "fmt": {
    "lineWidth": 150,
    "proseWrap": "preserve"
  }
}
