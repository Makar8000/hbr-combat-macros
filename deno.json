{
  "version": "1.0.1",
  "tasks": {
    "start": "deno run --allow-ffi --allow-read --allow-env --allow-sys src/main.ts",
    "scan:metadata": "deno run --allow-read --allow-write=scanner/out scanner/metadata.ts",
    "scan:fsm": "deno run --allow-ffi --allow-run=tasklist --allow-write=scanner/out scanner/fsm.ts",
    "scan:values": "deno run --allow-ffi --allow-run=tasklist scanner/values.ts",
    "scan:skills": "deno run --allow-ffi --allow-run=tasklist scanner/skills.ts",
    "scan:fields": "deno run --allow-ffi --allow-run=tasklist scanner/fields.ts",
    "scan:modules": "deno run --allow-ffi --allow-run=tasklist --allow-write=scanner/out scanner/modules.ts",
    "scan:behaviours": "deno run --allow-ffi --allow-run=tasklist --allow-write=scanner/out scanner/behaviours.ts",
    "scan:menu": "deno run --allow-ffi --allow-run=tasklist scanner/menu.ts",
    "compile": "deno compile --output hbr-combat-macros.exe --include src/assets --allow-ffi --allow-read --allow-env --allow-sys src/main.ts"
  },
  "imports": {
    "@cliffy/prompt": "jsr:@cliffy/prompt@^1.3.1",
    "@std/async": "jsr:@std/async@^1",
    "@std/csv": "jsr:@std/csv@^1",
    "@techstark/opencv-js": "npm:@techstark/opencv-js@5.0.0-release.1",
    "fast-png": "npm:fast-png@^8"
  },
  "fmt": {
    "lineWidth": 150,
    "proseWrap": "preserve"
  }
}
